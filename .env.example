# MongoDB connection string (required)
# Get from MongoDB Atlas: Database > Connect > Drivers
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/expenses?retryWrites=true&w=majority

# Cloudinary (expense attachments + stock photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Sheets webhook (Apps Script URL — see scripts/google-sheets-apps-script.gs)
# Sheet columns: Date | Opening Balance | Category | Expenses Amount | Notes | Add on | Source | Closing Balance | Requested by | Approved by
# Used as default for hariharan@gmail.com; other users set their own URL at registration.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec

# Optional — default Google Drive receipts folder (per-user override in Settings / Defaults)
# GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/your_folder_id

# Google Photos Picker (optional — enables "Google Photos" button on entry form)
# Enable Photos Picker API in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Hariharan Salt Works header banner (Cloudinary public URL)
NEXT_PUBLIC_SALT_BANNER_URL=https://res.cloudinary.com/your_cloud_name/image/upload/hariharan/header-banner.jpg

# Public stock view — optional
# /view redirects to /{username}/view for the default shop account
# Per-shop page: /{username}/view  e.g. /pavithra/view
# PUBLIC_STOCK_BUSINESS_ID=your_user_id
# PUBLIC_STOCK_TITLE=Pavithra Truck Alignment
# PUBLIC_STOCK_SUBTITLE=Real-time stock status
